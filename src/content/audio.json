 "m": {
  "Ah, o museu! É ali, à esquerda.": "m-3f6d3381776f6070.mp3",
  "Até logo!": "m-13a276d8dedf6bf9.mp3",
  "Bebes vinho ao jantar?": "m-7422cec78f40ec27.mp3",
  "Bom dia! Obrigado.": "m-faeb80c15c0d3848.mp3",
  "Bom fim de semana!": "m-6172bd51fd979af1.mp3",
  "Chamo-me Tom. E tu?": "m-25152ea138a9e236.mp3",
  "Combinado, até logo!": "m-62732e0a9164515f.mp3",
  "Deito-me sempre às onze.": "m-76e9035d2e628b70.mp3",
  "Desculpe, não percebo. Pode repetir, se faz favor?": "m-b7f134491d0ec929.mp3",
  "Desculpe, onde fica a estação?": "m-f6078838cb2f0ef3.mp3",
  "Desculpe, que horas são?": "m-78140d6f65f76b92.mp3",
  "Em frente e à direita. Obrigado!": "m-69ae8793df7e7d13.mp3",
  "Esta é a minha mãe.": "m-97cf25ddb9985595.mp3",
  "Estou bem, obrigado. E tu?": "m-5df343e3df11a006.mp3",
  "Eu saio de casa às oito e meia.": "m-4de390d26eb41515.mp3",
  "Falo um pouco. Estudo português todos os dias.": "m-f73949aa64f36860.mp3",
  "Gosto muito! E tu?": "m-04dc8f509b440c6f.mp3",
  "Levanto-me às sete. E tu?": "m-40ba1e09f652f5dc.mp3",
  "Lisboa é uma cidade bonita!": "m-03070279cd9d65c0.mp3",
  "Mais devagar, se faz favor.": "m-6ebaf1437ab2f335.mp3",
  "Moro em Berlim.": "m-4328573f2918b07e.mp3",
  "Muito prazer!": "m-3d29c55c1db5289b.mp3",
  "No domingo vou à praia.": "m-61731c71b6c93186.mp3",
  "Não, no sábado trabalho.": "m-c7cb150d347a855d.mp3",
  "Não, obrigado. A conta, se faz favor.": "m-edcb2b6c45d11114.mp3",
  "Não, obrigado. Quanto custa?": "m-b7007743866f014c.mp3",
  "Não, sem açúcar. E um pastel de nata.": "m-e42ca91e26373807.mp3",
  "O Pedro está aqui?": "m-87419f3d81ee1c24.mp3",
  "Obrigado, bom dia!": "m-b34035358b980bb6.mp3",
  "Obrigado. E onde fica a paragem do autocarro?": "m-99748a4f25fb7569.mp3",
  "Obrigado. Já é tarde!": "m-314839798ea62194.mp3",
  "Posso pagar com cartão?": "m-fa6b21d570445e8b.mp3",
  "Quando parte o comboio?": "m-f4a56ea56db5752d.mp3",
  "Quanto é, se faz favor?": "m-e89b1f7d2bb64c8e.mp3",
  "Queria um quilo de maçãs.": "m-af4bda2c0bb48a92.mp3",
  "Queria uma bica, se faz favor.": "m-a2d77d7b704624b1.mp3",
  "Sim! A que horas?": "m-c13b44cc6e479781.mp3",
  "Sim, sou alemão. E tu és portuguesa?": "m-c66f3486d59c39e6.mp3",
  "Sim, também falo inglês.": "m-276acb77190a7d9e.mp3",
  "Sou da Alemanha. E tu?": "m-2011f4347d7c00c6.mp3",
  "Sou engenheiro. Trabalho numa empresa alemã.": "m-25729ecb32a5d46d.mp3",
  "Tenho uma irmã.": "m-05a80afca77599cc.mp3",
  "Tenho vinte anos. E tu?": "m-013b1ed7b257d2d1.mp3",
  "Tens irmãos?": "m-8beb3abfd1ac7b8b.mp3",
  "Trabalha num hospital?": "m-8c0f569fc01aa972.mp3",
  "Um bilhete para o Porto, se faz favor.": "m-adbf790db5c295fc.mp3",
  "Vou visitar os meus pais. E tu?": "m-7b5f2a878d3f14f1.mp3",
  "É o meu pai. Chama-se João.": "m-52541947b1197c93.mp3"
 }
