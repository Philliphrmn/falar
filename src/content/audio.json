 },
 "m": {
  "Ah, o museu! É ali, à esquerda.": "m-3f4bfe491c9a7ecd.mp3",
  "Até logo!": "m-cc6e5c5aab81be89.mp3",
  "Bebes vinho ao jantar?": "m-512809f1582a2e13.mp3",
  "Bom dia! Obrigado.": "m-917ee5fa7d3b254e.mp3",
  "Bom fim de semana!": "m-7b8562d52a2e5c46.mp3",
  "Chamo-me Tom. E tu?": "m-76dc9ba63016ed0c.mp3",
  "Combinado, até logo!": "m-9ca66c1d2dc1594b.mp3",
  "Deito-me sempre às onze.": "m-e5b26d231d306445.mp3",
  "Desculpe, não percebo. Pode repetir, se faz favor?": "m-381a400aa356fd5e.mp3",
  "Desculpe, onde fica a estação?": "m-e25b57240a0954c8.mp3",
  "Desculpe, que horas são?": "m-d5d14d9855ba53b7.mp3",
  "Em frente e à direita. Obrigado!": "m-6cc3f62ffacfa1a2.mp3",
  "Esta é a minha mãe.": "m-5ca601463fe010bf.mp3",
  "Estou bem, obrigado. E tu?": "m-0d24d93822698bf3.mp3",
  "Eu saio de casa às oito e meia.": "m-ecbf619dbb050e64.mp3",
  "Falo um pouco. Estudo português todos os dias.": "m-c6b7345d43f58f43.mp3",
  "Gosto muito! E tu?": "m-e54ff47a761c5174.mp3",
  "Levanto-me às sete. E tu?": "m-ae243d0c889885c3.mp3",
  "Lisboa é uma cidade bonita!": "m-02d6e4fb45f60663.mp3",
  "Mais devagar, se faz favor.": "m-847d635d390105a5.mp3",
  "Moro em Berlim.": "m-37fe682c76b355dd.mp3",
  "Muito prazer!": "m-205ad3dd9e4c0809.mp3",
  "No domingo vou à praia.": "m-9cf6aa7ddcf68bbc.mp3",
  "Não, no sábado trabalho.": "m-53acb6d36258fad2.mp3",
  "Não, obrigado. A conta, se faz favor.": "m-42639601374906b8.mp3",
  "Não, obrigado. Quanto custa?": "m-c53da0e2082ad93e.mp3",
  "Não, sem açúcar. E um pastel de nata.": "m-ba42d80a9619ca7c.mp3",
  "O Pedro está aqui?": "m-69bff676dd733252.mp3",
  "Obrigado, bom dia!": "m-04e4b2289097168f.mp3",
  "Obrigado. E onde fica a paragem do autocarro?": "m-fbbfd6244e76ca7b.mp3",
  "Obrigado. Já é tarde!": "m-5b06743da769a62a.mp3",
  "Posso pagar com cartão?": "m-9092039fe06b71f9.mp3",
  "Quando parte o comboio?": "m-3f4435dc83ce6430.mp3",
  "Quanto é, se faz favor?": "m-fb4800e56c81d902.mp3",
  "Queria um quilo de maçãs.": "m-24cf572deaa24215.mp3",
  "Queria uma bica, se faz favor.": "m-b649e38643e7a081.mp3",
  "Sim! A que horas?": "m-92d145b6b4ae7450.mp3",
  "Sim, sou alemão. E tu és portuguesa?": "m-b616b977f1dfcbc7.mp3",
  "Sim, também falo inglês.": "m-60b58a4c44dcca26.mp3",
  "Sou da Alemanha. E tu?": "m-442ad36f27d7c4c4.mp3",
  "Sou engenheiro. Trabalho numa empresa alemã.": "m-1d308beb26fac78a.mp3",
  "Tenho uma irmã.": "m-38213ee4df914fcf.mp3",
  "Tenho vinte anos. E tu?": "m-9f104ea91afa4ee5.mp3",
  "Tens irmãos?": "m-57b9e521b564ab0b.mp3",
  "Trabalha num hospital?": "m-3f104c30780c19d0.mp3",
  "Um bilhete para o Porto, se faz favor.": "m-4fc197bb61a93ff8.mp3",
  "Vou visitar os meus pais. E tu?": "m-d26271010e8613d2.mp3",
  "É o meu pai. Chama-se João.": "m-695dbd01d9968f38.mp3"
